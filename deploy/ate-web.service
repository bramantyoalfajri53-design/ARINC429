[Unit]
Description=ATE Operator UI (station kernel daemon)
After=network-online.target nidevldu.service gpibenumsvc.service nipal.service
Wants=network-online.target
Conflicts=ate-power-hmi.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=paridit
Group=paridit
WorkingDirectory=/home/paridit/project/ate-platform
Environment=PATH=/home/paridit/project/ate-platform/.venv/bin:/usr/local/bin:/usr/bin
Environment=PYTHONPATH=/home/paridit/project/ATE/.venv/lib/python3.10/site-packages
Environment="LD_LIBRARY_PATH=/usr/local/lib:/home/paridit/project/ATE/driver/Astronic Ballard/BTIDRIVER/DRIVERINTEL64"
EnvironmentFile=-/home/paridit/project/ate-platform/.env
ExecStart=/home/paridit/project/ate-platform/.venv/bin/ate-web --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
